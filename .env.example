# Optional. Leave empty to run on localStorage only (no sign-in, no cloud sync).
# Copy these from your own Firebase project: Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Folder or CDN that holds the exercise demo clips (<id>.mp4). Defaults to /videos.
VITE_VIDEO_BASE=
